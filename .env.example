# ============================================================
# AI GATEWAY API — Environment variables (Node.js flow)
# Copy this file to .env for `npm start` (serves site + API).
# For Cloudflare local dev, copy .dev.vars.example to .dev.vars.
# In production (Cloudflare Pages), set these in:
#   Dashboard > your Pages project > Settings > Environment variables
# ============================================================

# --- Branding (single source of truth — shown on every page & endpoint) ------
APP_NAME=AI Gateway API
APP_VERSION=1.0.0

# --- Automatic provider failover ---------------------------------------------
# When a provider errors, the gateway retries the next configured provider
# until a response arrives. FAILOVER_ENABLED=false disables it globally.
FAILOVER_ENABLED=true
FAILOVER_MAX_ROUNDS=3
FAILOVER_RETRY_DELAY_MS=800

# --- Routing -----------------------------------------------------------------
# Default provider used when a request does not specify "provider".
# One of: openrouter | opencodezen | poolside | custom
DEFAULT_PROVIDER=openrouter

# --- OpenRouter ----------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-real-key
# Optional model override (legacy MODEL_NAME also supported)
OPENROUTER_MODEL=z-ai/glm-5.2:free

# --- OpenCode Zen (optional) -----------------------------------
# https://opencode.ai — coding frontier models. Its model catalog is PUBLIC
# (listed on /models even without a key); chat needs the key below.
OPENCODEZEN_API_KEY=
OPENCODEZEN_MODEL=deepseek-v4-flash-free

# --- Poolside AI (optional) -----------------------------------
# https://poolside.ai — Laguna code-intelligence models
POOLSIDE_API_KEY=
POOLSIDE_MODEL=poolside/laguna-s-2.1

# --- Custom OpenAI-compatible provider (optional) --------------
# Works with: OpenAI, DeepSeek, Together, vLLM, Ollama (OpenAI mode),
# LM Studio, OpenRouter itself, or ANY OpenAI-compatible base URL.
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# --- Telegram bot (functional webhook at /api/telegram/<SECRET>) --------------
# Create a bot with @BotFather, then set:
TELEGRAM_BOT_TOKEN=
# Any long random string; the webhook path must match it (403 otherwise).
TELEGRAM_WEBHOOK_SECRET=
# Optional:
TELEGRAM_BOT_USERNAME=
TELEGRAM_MAX_TOKENS=1200

# --- Secure YOUR OWN API (recommended in production) -----------
# If set, clients must send header:  X-API-Key: <this value>
# Leave empty to keep the API open.
API_SECRET_KEY=

# --- CORS ------------------------------------------------------
# Comma-separated origins, or * for all (default *).
# Example: ALLOWED_ORIGINS=https://yoursite.com,https://app.yoursite.com
ALLOWED_ORIGINS=*

# --- Rate limiting (per instance; see README for Cloudflare note)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=15

# --- Validation & upstream behavior ----------------------------
MAX_MESSAGE_LENGTH=8000
MAX_MESSAGES=50
MAX_TOKENS_LIMIT=8192
PROVIDER_TIMEOUT_MS=60000

# --- Live model catalog (GET /api/v1/models) -------------------
# How long the merged catalog is cached before the next request re-fetches it.
MODELS_CACHE_TTL_MS=21600000

# --- Misc ------------------------------------------------------
# Optional build-time override for the docs site when the API is hosted on a
# different domain. Leave empty = auto-detect from the browser address bar.
API_BASE_URL=
APP_URL=http://localhost:5000
NODE_ENV=development
PORT=5000
